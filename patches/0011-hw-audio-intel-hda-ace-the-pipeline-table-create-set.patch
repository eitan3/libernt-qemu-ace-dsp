 hw/audio/intel-hda-ace-regs.h         |  46 ++++++
 hw/audio/intel-hda-ace.c              | 203 +++++++++++++++++++++++++-
 hw/audio/trace-events                 |   1 +
 4 files changed, 266 insertions(+), 3 deletions(-)

