+/* --------------------------------------------------------------------- */
+/* the module table                                                       */
+
+/* What the firmware tracks of the host's module instances: init instance
+ * adds one with its configuration, large-config set replaces a copier's
+ * configuration, bind records which module feeds which, delete instance
+ * removes it.  Of a configuration the model reads only what the plan's 5.6
+ * defines and the gateways need -- the base configuration's buffer sizes
+ * and input format, and a copier's output format and gateway -- and judges
+ * nothing else in it.  Which module id is a copier is the firmware's own
+ * knowledge (the driver resolves it from the image's manifest), so the
+ * model knows a copier by the length of its configuration: 21 words and up
+ * carry the copier's tail.  The answers the plan does not fix are model
+ * values (MODEL-NOTES.md lists them). */
+
+#define ACE_MODEL_NO_MODULE 0xffffffffu
+
+static int ace_mod_find(IntelHDAAceState *s, uint32_t id, uint32_t instance)
+{
+    unsigned int i;
+
+    for (i = 0; i < ACE_MODEL_MAX_MODULES; i++) {
+        if (s->mod[i].used && s->mod[i].id == id &&
+            s->mod[i].instance == instance) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+/* the bytes of one frame of an audio format: the container depth (word 1)
+ * over eight, times the channels (word 5, bits 7:0); 0 for a depth or a
+ * channel count the model does not carry */
+static uint32_t ace_frame_bytes(uint32_t depth, uint32_t channels)
+{
+    if ((depth != 16 && depth != 24 && depth != 32) ||
+        channels == 0 || channels > 8) {
+        return 0;
+    }
+    return (depth == 16 ? 2 : 4) * channels;
+}
+
+/* the configuration of `words` dwords at the start of the downlink mailbox
+ * read into *m (the instance's identity and binding are the caller's) */
+static void ace_config_parse(IntelHDAAceState *s, uint32_t words, AceModule *m)
+{
+    const uint8_t *dl = s->ram[1];      /* the downlink mailbox: window 1 at +0 */
+    uint32_t w[ACE_CFG_COPIER_CONFIG_WORDS] = { 0 };
+    uint32_t i, depth, channels, node;
+
+    for (i = 0; i < MIN(words, ACE_CFG_COPIER_CONFIG_WORDS); i++) {
+        w[i] = ldl_le_p(dl + 4 * i);
+    }
+    m->ibs = w[1];
+    m->obs = w[2];
+    m->rate = w[ACE_CFG_BASE_CONFIG_WORDS - ACE_CFG_AUDIO_FORMAT_WORDS +
+               ACE_FMT_SAMPLING_RATE];
+    depth = w[ACE_CFG_BASE_CONFIG_WORDS - ACE_CFG_AUDIO_FORMAT_WORDS +
+            ACE_FMT_CONTAINER_DEPTH];
+    channels = w[ACE_CFG_BASE_CONFIG_WORDS - ACE_CFG_AUDIO_FORMAT_WORDS +
+                ACE_FMT_CHANNELS] & ACE_FMT_CHANNELS_MASK;
+    m->sample = depth == 16 ? 2 : 4;
+    m->frame_in = ace_frame_bytes(depth, channels);
+    m->copier = words >= ACE_CFG_COPIER_CONFIG_WORDS;
+    m->gateway = false;
+    m->gw_type = 0;
+    m->gw_index = ACE_CFG_NODE_INDEX_PLACEHOLDER;
+    m->frame_out = 0;
+    if (!m->copier) {
+        return;
+    }
+    m->frame_out = ace_frame_bytes(
+        w[ACE_CFG_OUT_FORMAT_WORD + ACE_FMT_CONTAINER_DEPTH],
+        w[ACE_CFG_OUT_FORMAT_WORD + ACE_FMT_CHANNELS] & ACE_FMT_CHANNELS_MASK);
+    node = w[ACE_CFG_NODE_ID_WORD];
+    m->gateway = true;
+    m->gw_type = (node & ACE_CFG_NODE_TYPE_MASK) >> ACE_CFG_NODE_TYPE_SHIFT;
+    m->gw_index = node & ACE_CFG_NODE_INDEX_MASK;
+}
+
+/* the configuration as the trace names it */
+static char *ace_mod_kind(const AceModule *m)
+{
+    const char *side;
+
+    if (!m->copier) {
+        return g_strdup_printf("base configuration, ibs %u obs %u", m->ibs, m->obs);
+    }
+    if (m->gw_type == ACE_CFG_NODE_HOST_OUTPUT ||
+        m->gw_type == ACE_CFG_NODE_HOST_INPUT) {
+        side = m->gw_type == ACE_CFG_NODE_HOST_OUTPUT ? "host-output" : "host-input";
+        if (m->gw_index == ACE_CFG_NODE_INDEX_PLACEHOLDER) {
+            return g_strdup_printf("copier, %s gateway without a stream (the "
+                                   "placeholder index 0xff), ibs %u obs %u",
+                                   side, m->ibs, m->obs);
+        }
+        return g_strdup_printf("copier, %s gateway index %u (stream tag %u), "
+                               "ibs %u obs %u", side, m->gw_index,
+                               m->gw_index + 1, m->ibs, m->obs);
+    }
+    return g_strdup_printf("copier, gateway type %u (not forwarded), ibs %u obs %u",
+                           m->gw_type, m->ibs, m->obs);
+}
+
+/* the status of a module message, with the table updated as the firmware
+ * would.  *detail receives the decoded message for the trace. */
+static uint32_t ace_module_status(IntelHDAAceState *s, uint32_t type,
+                                  uint32_t primary, uint32_t ext,
+                                  char **detail)
+{
+    uint32_t id = primary & ACE_IPC4_MOD_ID_MASK;
+    uint32_t instance = (primary & ACE_IPC4_MOD_INSTANCE_MASK) >>
+                        ACE_IPC4_MOD_INSTANCE_SHIFT;
+    uint32_t dst_id = ext & ACE_IPC4_BIND_DST_ID_MASK;
+    uint32_t dst_instance = (ext & ACE_IPC4_BIND_DST_INSTANCE_MASK) >>
+                            ACE_IPC4_BIND_DST_INSTANCE_SHIFT;
+    int mi = ace_mod_find(s, id, instance), di;
+    unsigned int i;
+    AceModule *m;
+
+    switch (type) {
+    case ACE_IPC4_MOD_INIT_INSTANCE: {
+        uint32_t size = ext & ACE_IPC4_MOD_EXT_SIZE_MASK;
+        uint32_t ppl = (ext & ACE_IPC4_MOD_EXT_PPL_MASK) >> ACE_IPC4_MOD_EXT_PPL_SHIFT;
+        g_autofree char *kind = NULL;
+
+        if (mi >= 0) {
+            *detail = g_strdup_printf("module %u instance %u exists", id, instance);
+            return ACE_IPC4_RESOURCE_ID_EXISTS;
+        }
+        if (size > ACE_SRAM_MBOX_SIZE / 4) {
+            *detail = g_strdup_printf("module %u instance %u: %u dwords do not fit "
+                                      "the downlink mailbox", id, instance, size);
+            return ACE_IPC4_ERROR_INVALID_PARAM;
+        }
+        mi = -1;
+        for (i = 0; i < ACE_MODEL_MAX_MODULES && mi < 0; i++) {
+            if (!s->mod[i].used) {
+                mi = i;
+            }
+        }
+        if (mi < 0) {
+            *detail = g_strdup_printf("module %u instance %u: the module table is full",
