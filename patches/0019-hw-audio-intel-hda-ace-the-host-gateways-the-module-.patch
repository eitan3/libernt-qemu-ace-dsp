+/* one entry of the firmware's module table: a module instance the host
+ * initialised (the fields of its configuration are those the gateways
+ * read; the rest of the configuration is not kept) */
+typedef struct AceModule {
+    bool used;
+    uint32_t id, instance;      /* as the messages address the instance */
+    uint32_t ppl;               /* the pipeline of its init-instance extension */
+    uint32_t src;               /* the module bound to its input, an index or ACE_MODEL_NO_MODULE */
+    bool copier;                /* its configuration carried the copier's tail */
+    bool gateway;               /* ... with a gateway node id */
+    uint32_t gw_type;           /* the gateway's type (host output, host input, ...) */
+    uint32_t gw_index;          /* the node index = stream tag - 1; the placeholder: none */
+    uint32_t ibs, obs;          /* the base configuration's buffer sizes */
+    uint32_t rate;              /* the input format's sampling frequency */
+    uint32_t sample;            /* bytes of one sample of the input format */
+    uint32_t frame_in, frame_out;   /* bytes of one frame, in and out */
+} AceModule;
+
+/* one pipeline's host gateway at work: its host-output gateway's stream
+ * is drained period by period into its host-input gateway's stream */
