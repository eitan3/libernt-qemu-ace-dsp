+/* --------------------------------------------------------------------- */
+/* the host gateways: a running pipeline's PCM between the host's streams */
+
+/* The plan's 5.9: a host copier's gateway names an HD Audio stream by its
+ * tag (the node index is the tag minus one) and the stream carries the PCM
+ * between the host's cyclic buffer and the firmware's copier.  The model's
+ * pipeline is a wire: while the pipeline is RUNNING, each period drains the
+ * host-output gateway's stream through DMA exactly as the ROM consumer
+ * drains the loader stream -- the descriptor list walked as
+ * intel_hda_xfer() walks it, bounded by SPIB -- and writes the bytes into
+ * the host-input gateway stream of the copier bound behind it (through the
+ * modules bound in between, which change nothing here).  A period is the
+ * run of descriptors up to the next that interrupts on completion and
+ * takes as long as its bytes at the stream's rate, so positions and
+ * interrupts advance as the host expects.  The wire, the pacing and a
+ * capture stream that is not running losing the period are model values
+ * (MODEL-NOTES.md lists them). */
+
+/* the bytes one DMA read and one DMA write move at most */
+#define ACE_AUDIO_CHUNK 4096
+
+/* the bytes of one cycle of a stream: the whole descriptor list, or the
+ * SPIB value when the host set a smaller one (the loader stream's bound) */
+static uint32_t ace_stream_cycle(IntelHDAState *d, unsigned int idx)
+{
+    uint64_t total = 0;
+    uint32_t i;
+
+    for (i = 0; i < d->st[idx].bentries; i++) {
+        total += d->st[idx].bpl[i].len;
+    }
+    if (total > UINT32_MAX) {
+        total = UINT32_MAX;
+    }
+    if (d->spib[idx] && d->spib[idx] < total) {
+        return d->spib[idx];
+    }
+    return total;
+}
+
+/* completes the stream's current descriptor when it is used up, noting its
+ * interrupt on completion; the cycle restarts at the end of the list */
+static void ace_entry_done(IntelHDAStream *st, bool *irq)
+{
+    if (st->bp != st->bpl[st->be].len) {
+        return;
+    }
+    if (st->bpl[st->be].flags & 0x01) {
+        *irq = true;
+    }
+    st->bp = 0;
+    if (++st->be == st->bentries) {
+        st->be = 0;
+        st->lpib = 0;
+    }
+}
+
+/* the bytes the stream's current descriptor still holds */
+static uint32_t ace_entry_left(IntelHDAStream *st, bool *irq)
+{
+    ace_entry_done(st, irq);
+    return st->bpl[st->be].len - st->bp;
+}
+
+/* the bytes of the stream's next period: from its position to the end of
+ * the next descriptor that interrupts on completion, or to the end of the
+ * cycle when none does */
+static uint32_t ace_period_bytes(IntelHDAStream *st, uint32_t cycle)
+{
+    uint32_t i = st->be, bytes = 0, n;
+
+    if (st->lpib >= cycle) {
+        return 0;       /* the SPIB value no longer reaches the position */
+    }
+    for (n = 0; n < st->bentries; n++) {
+        bytes += st->bpl[i].len - (n == 0 ? st->bp : 0);
+        if ((st->bpl[i].flags & 0x01) && st->bpl[i].len > 0) {
+            break;
+        }
+        if (++i == st->bentries) {
+            i = 0;
+        }
+    }
+    return MIN(bytes, cycle - st->lpib);
+}
+
+/* the controller stream of a host gateway: the output (host -> DSP) or the
+ * input (DSP -> host) stream that runs with the gateway's tag, the node
+ * index being the tag minus one (the plan's 5.6); -1 when there is none */
+static int ace_gateway_stream(IntelHDAAceState *s, uint32_t gw_index, bool output)
+{
+    IntelHDAState *d = &s->hda;
+    unsigned int i, tag = gw_index + 1;
+
+    if (gw_index == ACE_CFG_NODE_INDEX_PLACEHOLDER) {
+        return -1;
+    }
+    for (i = output ? 4 : 0; i < (output ? 8 : 4); i++) {
+        if ((d->st[i].ctl & 0x02) && ((d->st[i].ctl >> 20) & 0x0f) == tag) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+/* the host-input copier the host-output copier `from` feeds: the module
+ * bound behind it, then the one bound behind that, up to the binding depth
+ * (copier -> gain -> copier); -1 when there is none */
+static int ace_mod_sink(IntelHDAAceState *s, int from)
+{
+    unsigned int i, depth;
+    int cur = from, next;
+
+    for (depth = 0; depth < ACE_MODEL_MAX_BINDING_DEPTH; depth++) {
+        next = -1;
+        for (i = 0; i < ACE_MODEL_MAX_MODULES; i++) {
+            if (s->mod[i].used && s->mod[i].src == cur) {
+                next = i;
+                break;
+            }
+        }
+        if (next < 0) {
+            return -1;
+        }
+        if (s->mod[next].copier && s->mod[next].gateway &&
+            s->mod[next].gw_type == ACE_CFG_NODE_HOST_INPUT) {
+            return next;
+        }
+        cur = next;
+    }
+    return -1;
+}
+
+/* the position of a stream as the host reads it: the position buffer's
+ * entry, written whenever the model writes the position; the extended
+ * DMA-position register reads the same value */
+static void ace_stream_report(IntelHDAState *d, unsigned int idx)
+{
+    const MemTxAttrs attrs = { .memory = true };
+    hwaddr dpib;
+
+    if (!(d->dp_lbase & 0x01)) {
+        return;
+    }
+    dpib = ((uint64_t)d->dp_ubase << 32) | (d->dp_lbase & ~0x01);
+    stl_le_pci_dma(&d->pci, dpib + 8 * idx, d->st[idx].lpib, attrs);
+}
+
+/* the positions of the two streams after a period */
+static void ace_gateway_position(IntelHDAState *d, IntelHDAStream *src,
+                                 IntelHDAStream *dst)
+{
+    ace_stream_report(d, src - d->st);
+    if (dst) {
+        ace_stream_report(d, dst - d->st);
+    }
+}
+
+/* the period's interrupts: a descriptor that interrupts on completion was
+ * used up, so the stream's completion bit is set and the controller's line
+ * follows INTCTL */
+static void ace_gateway_irq(IntelHDAState *d, IntelHDAStream *src,
+                            IntelHDAStream *dst, bool irq_src, bool irq_dst)
+{
+    if (irq_src) {
+        src->ctl |= (1u << 26);
+    }
+    if (dst && irq_dst) {
+        dst->ctl |= (1u << 26);
+    }
+    intel_hda_update_irq(d);
+}
+
+/* one period: `bytes` read from the render stream's descriptors and, when
+ * the capture stream runs, written into its own, the two walked as
+ * intel_hda_xfer() walks a stream; then the positions, the interrupts and
+ * the evidence lines */
+static void ace_gateway_copy(IntelHDAAceState *s, AceGateway *g, uint32_t bytes)
+{
+    IntelHDAState *d = &s->hda;
+    IntelHDAStream *src = &d->st[g->render];
+    IntelHDAStream *dst = g->capture >= 0 ? &d->st[g->capture] : NULL;
+    uint32_t cycle_src = ace_stream_cycle(d, g->render);
+    uint32_t cycle_dst = dst ? ace_stream_cycle(d, g->capture) : 0;
+    uint32_t left = bytes, sample = g->sample;
+    bool irq_src = false, irq_dst = false;
+    bool failed = false, stop = false;
+    uint32_t i, k, n, nfirst = 0;
+    uint64_t count = 0;
+    int32_t first[8];
+    double sumsq = 0;
+    int64_t peak = 0;
+    const MemTxAttrs attrs = { .memory = true };
+    g_autofree char *rms = NULL;
+    char first_text[9 + 8 * 12];
+    size_t len = 5;
+
+    /* every step moves bytes or completes an empty descriptor, of which
+     * the list holds at most 256: the bound is the guest's, not a loop */
+    for (i = 0; left > 0 && i < bytes + 2 * 256 + 16; i++) {
+        /* a cycle the SPIB value cut short restarts at the first descriptor */
+        if (src->lpib >= cycle_src) {
+            src->be = 0;
+            src->bp = 0;
+            src->lpib = 0;
+        }
+        if (dst && dst->lpib >= cycle_dst) {
+            dst->be = 0;
+            dst->bp = 0;
+            dst->lpib = 0;
+        }
+        n = MIN(left, ace_entry_left(src, &irq_src));
+        n = MIN(n, cycle_src - src->lpib);
+        if (dst) {
+            n = MIN(n, ace_entry_left(dst, &irq_dst));
+            n = MIN(n, cycle_dst - dst->lpib);
+        }
+        n = MIN(n, ACE_AUDIO_CHUNK);
+        if (n == 0) {
+            continue;
+        }
+        if (pci_dma_rw(&d->pci, src->bpl[src->be].addr + src->bp, s->audio_buf, n,
+                       DMA_DIRECTION_TO_DEVICE, attrs) != MEMTX_OK) {
+            failed = true;
+            break;
+        }
+        if (dst &&
+            pci_dma_rw(&d->pci, dst->bpl[dst->be].addr + dst->bp, s->audio_buf, n,
+                       DMA_DIRECTION_FROM_DEVICE, attrs) != MEMTX_OK) {
+            failed = true;
+            break;
+        }
+        for (k = 0; k + sample <= n; k += sample) {
+            int64_t v = sample == 2 ? (int16_t)lduw_le_p(s->audio_buf + k)
+                                    : (int32_t)ldl_le_p(s->audio_buf + k);
+
+            if (nfirst < 8) {
+                first[nfirst++] = v;
+            }
+            count++;
+            sumsq += (double)v * v;
+            if (v < 0 ? -v > peak : v > peak) {
+                peak = v < 0 ? -v : v;
+            }
+        }
+        src->bp += n;
+        src->lpib += n;
+        left -= n;
+        if (dst) {
+            dst->bp += n;
+            dst->lpib += n;
+        }
+    }
+    if (failed || left > 0) {
+        /* the period is not whole: the gateway stops on it (the positions
+         * and the interrupts of what did move are still reported) */
+        stop = true;
+    }
+    ace_entry_done(src, &irq_src);
+    if (dst) {
+        ace_entry_done(dst, &irq_dst);
+    }
+    ace_gateway_position(d, src, dst);
+    ace_gateway_irq(d, src, dst, irq_src, irq_dst);
+
+    /* one evidence line per stream and period: what the host sent and what
+     * it will read back, the same bytes */
+    memcpy(first_text, "first", len);
+    first_text[len] = '\0';
+    for (k = 0; k < nfirst; k++) {
+        len += snprintf(first_text + len, sizeof(first_text) - len,
+                        " %" PRId32, first[k]);
+    }
+    rms = g_strdup_printf("%.3f", count ? sqrt(sumsq / count) : 0.0);
+    trace_ace_audio((src->ctl >> 20) & 0x0f, bytes - left, rms, peak, first_text);
+    if (dst) {
+        trace_ace_audio((dst->ctl >> 20) & 0x0f, bytes - left, rms, peak,
+                        first_text);
+    }
+    if (stop) {
+        g->active = false;
+        trace_ace_gateway("stopped", g->ppl,
+                          failed ? "a descriptor's DMA failed: the period is cut short"
+                                 : "the period could not be moved whole");
+    }
+}
+
+static void ace_gateway_cb(void *opaque)
+{
+    AceGateway *g = opaque;
+    IntelHDAAceState *s = g->s;
+    IntelHDAStream *st;
+    uint32_t cycle, bytes;
+
+    if (!g->active) {
+        return;
+    }
+    /* the streams' run bits are the contract: a stream reset or stopped
+     * behind the model's back ends or narrows the gateway here */
+    ace_gateways_update(s);
+    if (!g->active) {
+        return;             /* stopped: its trace says why */
+    }
+    st = &s->hda.st[g->render];
+    cycle = ace_stream_cycle(&s->hda, g->render);
+    bytes = ace_period_bytes(st, cycle);
+    if (bytes > 0) {
+        ace_gateway_copy(s, g, bytes);
+        if (!g->active) {
+            return;         /* stopped on it: its trace says why */
+        }
+        bytes = ace_period_bytes(st, cycle);
+    }
+    if (bytes == 0) {
+        g->active = false;
+        trace_ace_gateway("stopped", g->ppl, "the render stream has no more bytes to move");
+        return;
+    }
+    /* the next period takes as long as its bytes at the stream's rate */
+    ace_arm(g->timer, (uint64_t)bytes * 1000000000 / g->bps);
+}
+
+/* arms, narrows and stops the gateways after anything that may have
+ * changed them: a pipeline's state, the module table, a stream's run bit */
+static void ace_gateways_update(IntelHDAAceState *s)
+{
+    unsigned int p, i;
+
+    for (p = 0; p < ACE_MODEL_MAX_PIPELINES; p++) {
+        AceGateway *g = &s->gw[p];
+        AcePipeline *ppl = &s->ppl[p];
+        AceModule *m = NULL, *k = NULL;
+        g_autofree char *why = NULL;
+        int src = -1, sink = -1, render = -1, capture = -1;
+        uint32_t bps = 0, sample = 0;
+
+        if (!ppl->used) {
+            why = g_strdup("the pipeline is gone");
+        } else if (ppl->state != ACE_IPC4_PIPE_RUNNING) {
+            why = g_strdup_printf("pipeline %u is %s", p + 1,
+                                  ace_ppl_state_name(ppl->state));
+        } else {
+            for (i = 0; i < ACE_MODEL_MAX_MODULES && src < 0; i++) {
+                m = &s->mod[i];
+                if (m->used && m->copier && m->gateway && m->ppl == p + 1 &&
+                    m->gw_type == ACE_CFG_NODE_HOST_OUTPUT &&
+                    m->gw_index != ACE_CFG_NODE_INDEX_PLACEHOLDER) {
+                    src = i;
+                }
+            }
+            if (src < 0) {
+                why = g_strdup("no host-output copier with a stream");
+            } else {
+                m = &s->mod[src];
+                sink = ace_mod_sink(s, src);
+                k = sink >= 0 ? &s->mod[sink] : NULL;
+                if (!k) {
+                    why = g_strdup("no host-input copier bound behind the "
+                                   "host-output copier");
+                } else if (k->gw_index == ACE_CFG_NODE_INDEX_PLACEHOLDER) {
+                    why = g_strdup("the host-input copier has no stream");
+                } else if (!m->frame_in || k->frame_out != m->frame_in) {
+                    why = g_strdup_printf("the frame changes across the pipeline "
+                                          "(%u bytes in, %u out): not modelled",
+                                          m->frame_in, k->frame_out);
+                } else if (!m->rate) {
+                    why = g_strdup("the input format names no sampling frequency");
+                } else if ((render = ace_gateway_stream(s, m->gw_index, true)) < 0) {
+                    why = g_strdup_printf("stream %u, the host-output gateway's, "
+                                          "is not running", m->gw_index + 1);
+                } else {
+                    capture = ace_gateway_stream(s, k->gw_index, false);
+                    bps = m->rate * m->frame_in;
+                    sample = m->sample;
+                }
+            }
+        }
+        if (render >= 0) {
+            uint32_t bytes;
+
+            if (!g->active) {
+                g_autofree char *id = g_strdup_printf("%u.%u", m->id, m->instance);
+                g_autofree char *kd = g_strdup_printf("%u.%u", k->id, k->instance);
+                g_autofree char *msg = g_strdup_printf(
+                    "host-output copier %s drains stream %u into host-input "
+                    "copier %s's stream %u%s; %u bytes a second", id,
+                    m->gw_index + 1, kd, k->gw_index + 1,
+                    capture < 0 ? " (not running: its samples are dropped)" : "",
+                    bps);
+
+                g->active = true;
+                trace_ace_gateway("armed", p + 1, msg);
+                bytes = ace_period_bytes(&s->hda.st[render],
+                                         ace_stream_cycle(&s->hda, render));
+                ace_arm(g->timer, (uint64_t)bytes * 1000000000 / bps);
+            }
+            g->ppl = p + 1;
+            g->render = render;
+            g->capture = capture;
+            g->bps = bps;
+            g->sample = sample;
+        } else if (g->active) {
+            g->active = false;
+            timer_del(g->timer);
+            trace_ace_gateway("stopped", p + 1, why);
+        }
+    }
+}
+
+/* --------------------------------------------------------------------- */
+/* BAR0: the extended DMA-position registers                              */
+
+/* The vendor-specific block the host reads a DSP stream's position from:
+ * one read-only register per stream, the mirror of the position buffer's
+ * entry (a model value: the plan's 5.9 has the host read this register and
+ * log the position buffer beside it, for silicon to say which is right). */
+static uint64_t ace_xdpib_read(void *opaque, hwaddr off, unsigned size)
+{
+    IntelHDAAceState *s = opaque;
+
+    if (off % ACE_BAR0_XDPIB_INTERVAL == 0) {
+        return s->hda.st[off / ACE_BAR0_XDPIB_INTERVAL].lpib;
+    }
+    qemu_log_mask(LOG_UNIMP, "intel-hda-ace: read at BAR0 +0x%" HWADDR_PRIX
