From 46998f8106f49fe7612da405a99785ce20af01a9 Mon Sep 17 00:00:00 2001
From: Tasker <tasker@localhost>
Date: Wed, 25 Nov 2026 19:30:58 +0200
Subject: [PATCH 20/20] tests/qtest: intel-hda-ace: the host gateways move a
 loopback's PCM

One case, audio-loopback, on the driver's loopback topology -- host
copier playback (module 5, instance 0) -> gain (7, 0) -> host copier
capture (5, 1) in pipeline 1 -- with the copier configuration of the
plan's 5.6 (the C2 builder's 21 words, the gateway index the stream tag
minus one) written into the downlink mailbox: the render stream (output
5, tag 2) carries a pattern of constant magnitude, the capture stream
(input 0, tag 3) a buffer filled otherwise.  In the driver's order
(create, init, bind; paused, running; the streams run, the capture
first) one period of 2048 bytes moves the render's first half into the
capture byte for byte, both positions read 2048 as LPIB, in the position
buffer and in the extended DMA-position register, both streams'
completion bits are set and the line is up; nothing moves before the
second period is due, which completes the cycle (the positions wrap to
0); a paused pipeline forwards nothing and running goes on; the render
stream stopped ends it; the extended register is read-only.

Then the module table's other answers (an instance that exists 10, one
that does not 9, a configuration in several blocks 7), the teardown, and
the C2 builder's placeholder: a copier initialised with index 0xff names
no stream and nothing moves until a large-config set names one.

The forwarding's mutation rows (gw-*) are in mutation-check.sh.
---
 tests/qtest/intel-hda-ace-test.c | 358 +++++++++++++++++++++++++++++++
 1 file changed, 358 insertions(+)

diff --git a/tests/qtest/intel-hda-ace-test.c b/tests/qtest/intel-hda-ace-test.c
index 870ffcb8b..9a16925b6 100644
--- a/tests/qtest/intel-hda-ace-test.c
+++ b/tests/qtest/intel-hda-ace-test.c
@@ -51,6 +51,12 @@
 #define HDA_ST_FMT(n)      (0x80 + 0x20 * (n) + 0x12)
 #define HDA_ST_BDLPL(n)    (0x80 + 0x20 * (n) + 0x18)
 #define HDA_ST_BDLPU(n)    (0x80 + 0x20 * (n) + 0x1c)
+#define HDA_XDPIB(n)       (0x1084 + 0x20 * (n)) /* extended DMA position, read-only */
+#define HDA_DPLBASE         0x70
+#define HDA_DPUBASE         0x74
+#define HDA_INTCTL_GIE      (1u << 31)
+#define SD_IOC              0x01                  /* a descriptor's interrupt on completion */
+#define SD_BCOL             (1u << 26)            /* a stream's buffer completion status */
 #define OUT4               4                    /* output stream 4, tag 1 */
 
 /* BAR4: the ACE 1.0 DSP registers (model values: the interrupt pointer) */
@@ -101,6 +107,19 @@
 #define PPL_EOS                 5u
 #define IPC4_ILLEGAL_TRANSITION 5u    /* the plan's status: "invalid resource state" */
 
+/* the module messages (target bit 30 = 1) the loopback needs, and the
+ * shapes of their requests and replies */
+#define IPC4_MOD_INIT            0u
+#define IPC4_MOD_LC_SET          4u
+#define IPC4_MOD_BIND            5u
+#define IPC4_MOD_DELETE          11u
+#define MOD_REQ(type, id, inst)  (ACE_BUSY | IPC4_MODULE | ((type) << 24) | ((inst) << 16) | (id))
+#define MOD_REPLY(type, status)  (ACE_BUSY | 0x20000000u | IPC4_MODULE | ((type) << 24) | (status))
+#define MOD_EXT(ppl, words)      (((ppl) << 16) | (words))     /* init instance: pipeline, dwords */
+#define BIND_EXT(id, inst)       (((inst) << 16) | (id))        /* bind: the destination */
+#define LC_EXT(param, bytes)     ((1u << 29) | (1u << 28) | ((param) << 20) | (bytes))
+#define ACE_WIN1                 0x188000                   /* the downlink mailbox at +0 */
+
 #define US(x) ((int64_t)(x) * 1000)
 
 /* guest memory for the test: the BDL and the synthetic image */
@@ -109,6 +128,24 @@
 #define IMG_PAYLOAD        0x100            /* the payload offset of the image */
 #define IMG_LEN            (IMG_PAYLOAD + 0x9000)
 
+/* guest memory of the loopback: the render and the capture buffers (four
+ * 1024-byte descriptors each, the second and the fourth interrupting on
+ * completion: a period is 2048 bytes, 256 frames of 32-bit stereo), their
+ * descriptor lists and the position buffer (eight 8-byte entries) */
+#define RENDER_ADDR         0x00200000
+#define CAPTURE_ADDR        0x00210000
+#define POSBUF_ADDR         0x00220000
+#define BDL_RENDER          0x00230000
+#define BDL_CAPTURE         0x00231000
+#define LOOP_BYTES          4096
+#define LOOP_PERIOD         2048                  /* 256 frames at 48 kHz: 5333 us */
+#define LOOP_TAG_RENDER     2                     /* output stream 5 */
+#define LOOP_TAG_CAPTURE    3                     /* input stream 0 */
+#define OUT5                5
+#define IN0                 0
+#define FMT_32_STEREO       0x0041                /* 48 kHz, 32-bit, 2 channels */
+#define LOOP_AMPLITUDE      1000000               /* the pattern's constant magnitude */
+
 static const uint8_t ri_magic_ae1[] = "$AE1";
 static const uint8_t ri_magic_cpd[] = "$CPD";
 static const uint8_t ri_magic_mn2[] = "$MN2";
@@ -147,6 +184,19 @@ static void w0w(uint64_t off, uint16_t v)
     qpci_io_writew(t.dev, t.bar0, off, v);
 }
 
+static void w0b(uint64_t off, uint8_t v)
+{
+    qpci_io_writeb(t.dev, t.bar0, off, v);
+}
+
+static uint32_t mem_read32(uint64_t addr)
+{
+    uint8_t p[4];
+
+    qtest_memread(t.qs, addr, p, sizeof(p));
+    return ldl_le_p(p);
+}
+
 static uint32_t r4(uint64_t off)
 {
     return qpci_io_readl(t.dev, t.bar4, off);
@@ -1089,6 +1139,313 @@ static void test_wrapped_offset(void)
     boot_end();
 }
 
+/* 15: the host gateways.  The driver's loopback topology -- host copier
+ * playback -> gain -> host copier capture in one pipeline -- with the
+ * copier configuration the plan's 5.6 lays out (the C2 builder's 21 words:
+ * base configuration, the output format of pin 0, the gateway whose node
+ * index is the stream tag minus one, the DMA buffer size, one dword of
+ * attributes): a running pipeline moves the render stream's descriptors
+ * into the capture stream's, period by period, byte for byte, advancing
+ * both positions and interrupting on the descriptors that ask for it. */
+
+/* the render pattern: every sample of magnitude LOOP_AMPLITUDE, left and
+ * right in antiphase, so the RMS is exactly the amplitude */
+static uint8_t loop_render[LOOP_BYTES];
+static const uint8_t loop_capture_fill = 0xaa;
+
+static void loop_pattern(void)
+{
+    uint32_t k;
+
+    for (k = 0; k < LOOP_BYTES / 8; k++) {
+        int32_t l = (k & 1) ? -LOOP_AMPLITUDE : LOOP_AMPLITUDE;
+
+        stl_le_p(loop_render + 8 * k, l);
+        stl_le_p(loop_render + 8 * k + 4, -l);
+    }
+}
+
+static void loop_bdl(uint32_t bdl, uint32_t addr)
+{
+    uint8_t e[64];
+    uint32_t i;
+
+    for (i = 0; i < 4; i++) {
+        stq_le_p(e + 16 * i, addr + 1024 * i);
+        stl_le_p(e + 16 * i + 8, 1024);
+        stl_le_p(e + 16 * i + 12, (i & 1) ? SD_IOC : 0);
+    }
+    qtest_memwrite(t.qs, bdl, e, sizeof(e));
+}
+
+/* a stream of the loopback: the format, its descriptor list, the cyclic
+ * buffer; SPIB set to the buffer size for the render stream, as the plan's
+ * 5.9 has the driver do */
+static void loop_setup(int n, uint32_t tag, uint32_t bdl)
+{
+    w0w(HDA_ST_FMT(n), FMT_32_STEREO);
+    w0(HDA_ST_BDLPU(n), 0);
+    w0(HDA_ST_BDLPL(n), bdl);
+    w0(HDA_ST_CBL(n), LOOP_BYTES);
+    w0(HDA_ST_LVI(n), 3);
+    w0(HDA_ST_CTL(n), 1);                 /* reset */
+    w0(HDA_ST_CTL(n), 0);
+    if (n >= 4) {
+        w0(HDA_SPIB(n), LOOP_BYTES);
+        w0(HDA_SPBFCCTL, 1u << n);
+    }
+    w0(HDA_ST_CTL(n), (uint32_t)(tag << 20) | 0x02);   /* tag, run */
+}
+
+static void loop_run(int n, bool run)
+{
+    w0(HDA_ST_CTL(n), (r0(HDA_ST_CTL(n)) & ~(0x02u | SD_BCOL)) | (run ? 0x02 : 0));
+}
+
+/* the module configuration of the plan's 5.6: the base module
+ * configuration with a 48 kHz 32-bit stereo format (rate, container depth,
+ * channel map, channel configuration, interleaving, the format config
+ * word: channels, valid bits, MSB-first integer), and for a copier the
+ * output format of pin 0, no feature, the gateway node id, a two-millisecond
+ * DMA buffer, one dword of gateway data and no attribute */
+static void loop_config(uint32_t node_id, uint32_t words)
+{
+    uint32_t w[21] = { 0 };
+    uint32_t i;
+
+    w[0] = 500000;                        /* cycles per chunk */
+    w[1] = 384;                           /* input buffer size */
+    w[2] = 384;                           /* output buffer size */
+    w[4] = 48000;
+    w[5] = 32;
+    w[6] = 0xffffff10;
+    w[7] = 1;
+    w[9] = (1u << 16) | (32u << 8) | 2;
+    for (i = 0; i < 6; i++) {
+        w[10 + i] = w[4 + i];
+    }
+    w[17] = node_id;
+    w[18] = 2 * 384;
+    w[19] = 1;
+    for (i = 0; i < words; i++) {
+        w4(ACE_WIN1 + 4 * i, w[i]);
+    }
+}
+
+/* the driver's loopback pipeline, in its order: create pipeline 1, init the
+ * three widgets (copier 5.0, copier 5.1, gain 7.0), bind the two edges */
+static void loop_build(uint32_t out_node, uint32_t in_node)
+{
+    g_assert_cmpuint(ipc(0, PPL_REQ(IPC4_CREATE_PIPELINE, 1)), ==, PPL_REPLY(IPC4_CREATE_PIPELINE, 0));
+    loop_config(out_node, 21);
+    g_assert_cmpuint(ipc(MOD_EXT(1, 21), MOD_REQ(IPC4_MOD_INIT, 5, 0)), ==, MOD_REPLY(IPC4_MOD_INIT, 0));
+    loop_config(in_node, 21);
+    g_assert_cmpuint(ipc(MOD_EXT(1, 21), MOD_REQ(IPC4_MOD_INIT, 5, 1)), ==, MOD_REPLY(IPC4_MOD_INIT, 0));
+    loop_config(0, 10);                   /* the gain: the base configuration alone */
+    g_assert_cmpuint(ipc(MOD_EXT(1, 10), MOD_REQ(IPC4_MOD_INIT, 7, 0)), ==, MOD_REPLY(IPC4_MOD_INIT, 0));
+    g_assert_cmpuint(ipc(BIND_EXT(7, 0), MOD_REQ(IPC4_MOD_BIND, 5, 0)), ==, MOD_REPLY(IPC4_MOD_BIND, 0));
+    g_assert_cmpuint(ipc(BIND_EXT(5, 1), MOD_REQ(IPC4_MOD_BIND, 7, 0)), ==, MOD_REPLY(IPC4_MOD_BIND, 0));
+}
+
+static void loop_teardown(void)
+{
+    g_assert_cmpuint(ipc(0, MOD_REQ(IPC4_MOD_DELETE, 5, 0)), ==, MOD_REPLY(IPC4_MOD_DELETE, 0));
+    g_assert_cmpuint(ipc(0, MOD_REQ(IPC4_MOD_DELETE, 5, 1)), ==, MOD_REPLY(IPC4_MOD_DELETE, 0));
+    g_assert_cmpuint(ipc(0, MOD_REQ(IPC4_MOD_DELETE, 7, 0)), ==, MOD_REPLY(IPC4_MOD_DELETE, 0));
+    g_assert_cmpuint(ipc(0, PPL_REQ(IPC4_DELETE_PIPELINE, 1)), ==, PPL_REPLY(IPC4_DELETE_PIPELINE, 0));
+}
+
+/* the position as the host sees it three times: LPIB, the extended
+ * DMA-position register and the position buffer's entry */
+static void check_position(int n, uint32_t want, const char *when)
+{
+    uint32_t posbuf = mem_read32(POSBUF_ADDR + 8 * n);
+
+    if (r0(HDA_ST_LPIB(n)) != want || r0(HDA_XDPIB(n)) != want || posbuf != want) {
+        g_test_message("%s: stream %d: LPIB %u, extended register %u, position "
+                       "buffer %u (wanted %u)", when, n, r0(HDA_ST_LPIB(n)),
+                       r0(HDA_XDPIB(n)), posbuf, want);
+    }
+    g_assert_cmpuint(r0(HDA_ST_LPIB(n)), ==, want);
+    g_assert_cmpuint(r0(HDA_XDPIB(n)), ==, want);
+    g_assert_cmpuint(posbuf, ==, want);
+}
+
+static void check_capture(uint32_t off, uint32_t bytes, const char *when)
+{
+    uint8_t *got = g_malloc(bytes);
+    uint32_t i;
+
+    qtest_memread(t.qs, CAPTURE_ADDR + off, got, bytes);
+    for (i = 0; i < bytes; i++) {
+        if (got[i] != loop_render[off + i]) {
+            g_test_message("%s: capture +0x%x is 0x%02x, the render has 0x%02x",
+                           when, off + i, got[i], loop_render[off + i]);
+        }
+        g_assert_cmpuint(got[i], ==, loop_render[off + i]);
+    }
+    g_free(got);
+}
+
+static void check_capture_fill(uint32_t off, uint32_t bytes, const char *when)
+{
+    uint8_t *got = g_malloc(bytes);
+    uint32_t i;
+
+    qtest_memread(t.qs, CAPTURE_ADDR + off, got, bytes);
+    for (i = 0; i < bytes; i++) {
+        if (got[i] != loop_capture_fill) {
+            g_test_message("%s: capture +0x%x was written (0x%02x)", when, off + i,
+                           got[i]);
+        }
+        g_assert_cmpuint(got[i], ==, loop_capture_fill);
+    }
+    g_free(got);
+}
+
+/* the two streams' completion bits and the controller's line: up together
+ * after a period, down together after the acknowledgement */
+static void check_loop_irq(bool asserted, const char *when)
+{
+    uint32_t got = r0(HDA_INTSTS) & ((1u << OUT5) | (1u << IN0) | (1u << 31));
+
+    if (got != (asserted ? (1u << OUT5) | (1u << IN0) | (1u << 31) : 0)) {
+        g_test_message("%s: INTSTS 0x%x", when, got);
+    }
+    g_assert_cmpuint(got, ==, asserted ? (1u << OUT5) | (1u << IN0) | (1u << 31) : 0);
+    if (asserted) {
+        g_assert_cmpint(asserted_gsi(), >=, 16);
+    } else {
+        g_assert_cmpint(asserted_gsi(), ==, -1);
+    }
+}
+
+/* the host acknowledges the period: the completion bits clear, the line drops */
+static void loop_ack(void)
+{
+    w0b(HDA_ST_CTL(OUT5) + 3, SD_BCOL >> 24);
+    w0b(HDA_ST_CTL(IN0) + 3, SD_BCOL >> 24);
+    g_assert_cmpuint(r0(HDA_ST_CTL(OUT5)) & SD_BCOL, ==, 0);
+    g_assert_cmpuint(r0(HDA_ST_CTL(IN0)) & SD_BCOL, ==, 0);
+    check_loop_irq(false, "after the acknowledgement");
+}
+
+static void test_audio_loopback(void)
+{
+    static const uint8_t zero[64];
+
+    boot_start("");
+    qtest_irq_intercept_in(t.qs, "ioapic");
+    boot_running();
+
+    loop_pattern();
+    qtest_memwrite(t.qs, RENDER_ADDR, loop_render, sizeof(loop_render));
+    qtest_memset(t.qs, CAPTURE_ADDR, loop_capture_fill, LOOP_BYTES);
+    qtest_memwrite(t.qs, POSBUF_ADDR, zero, sizeof(zero));
+    loop_bdl(BDL_RENDER, RENDER_ADDR);
+    loop_bdl(BDL_CAPTURE, CAPTURE_ADDR);
+    w0(HDA_DPUBASE, 0);
+    w0(HDA_DPLBASE, POSBUF_ADDR | 1);
+    w0(HDA_INTCTL, HDA_INTCTL_GIE | (1u << OUT5) | (1u << IN0));
+    g_assert_cmpint(asserted_gsi(), ==, -1);
+
+    /* the driver's sequence: create, init, bind; paused, running; then the
+     * streams run (the capture first: the copier can only push into a host
+     * input stream that is running) */
+    loop_build((0u << 8) | (LOOP_TAG_RENDER - 1), (1u << 8) | (LOOP_TAG_CAPTURE - 1));
+    g_assert_cmpuint(ipc(0, PPL_STATE(1, PPL_PAUSED)), ==, PPL_REPLY(IPC4_SET_PIPELINE_STATE, 0));
+    g_assert_cmpuint(ipc(0, PPL_STATE(1, PPL_RUNNING)), ==, PPL_REPLY(IPC4_SET_PIPELINE_STATE, 0));
+    loop_setup(IN0, LOOP_TAG_CAPTURE, BDL_CAPTURE);
+    loop_setup(OUT5, LOOP_TAG_RENDER, BDL_RENDER);
+
+    /* one period: 2048 bytes moved, both positions 2048 in all three
+     * places, the capture holds the render's first half, both streams
+     * completed an interrupting descriptor and the line is up */
+    qtest_clock_step(t.qs, US(5400));
+    check_position(OUT5, LOOP_PERIOD, "after the first period");
+    check_position(IN0, LOOP_PERIOD, "after the first period");
+    check_capture(0, LOOP_PERIOD, "after the first period");
+    check_capture_fill(LOOP_PERIOD, LOOP_PERIOD, "after the first period");
+    check_loop_irq(true, "after the first period");
+    loop_ack();
+
+    /* not before the second period is due */
+    qtest_clock_step(t.qs, US(5000));
+    check_position(OUT5, LOOP_PERIOD, "between the periods");
+    check_position(IN0, LOOP_PERIOD, "between the periods");
+    /* the second period completes the cycle: the positions wrap to 0, the
+     * capture holds the render's second half */
+    qtest_clock_step(t.qs, US(400));
+    check_position(OUT5, 0, "after the second period");
+    check_position(IN0, 0, "after the second period");
+    check_capture(LOOP_PERIOD, LOOP_PERIOD, "after the second period");
+    check_loop_irq(true, "after the second period");
+    loop_ack();
+
+    /* a paused pipeline forwards nothing; running again, it goes on from
+     * where the streams are (the extended register is read-only) */
+    g_assert_cmpuint(ipc(0, PPL_STATE(1, PPL_PAUSED)), ==, PPL_REPLY(IPC4_SET_PIPELINE_STATE, 0));
+    qtest_clock_step(t.qs, US(6000));
+    check_position(OUT5, 0, "paused");
+    check_position(IN0, 0, "paused");
+    w0(HDA_XDPIB(OUT5), 0x1234);
+    check_position(OUT5, 0, "paused (the extended register is read-only)");
+    g_assert_cmpuint(ipc(0, PPL_STATE(1, PPL_RUNNING)), ==, PPL_REPLY(IPC4_SET_PIPELINE_STATE, 0));
+    qtest_clock_step(t.qs, US(5400));
+    check_position(OUT5, LOOP_PERIOD, "after the third period");
+    check_position(IN0, LOOP_PERIOD, "after the third period");
+    check_loop_irq(true, "after the third period");
+    loop_ack();
+
+    /* the render stream stopped: nothing moves any more */
+    loop_run(OUT5, false);
+    qtest_clock_step(t.qs, US(6000));
+    check_position(OUT5, LOOP_PERIOD, "render stopped");
+    check_position(IN0, LOOP_PERIOD, "render stopped");
+    check_loop_irq(false, "render stopped");
+    loop_run(IN0, false);
+
+    /* the module table's other answers (model values): an instance that
+     * exists, one that does not, a configuration in several blocks */
+    loop_config(0, 10);
+    g_assert_cmpuint(ipc(MOD_EXT(1, 10), MOD_REQ(IPC4_MOD_INIT, 5, 0)), ==, MOD_REPLY(IPC4_MOD_INIT, 10));
+    g_assert_cmpuint(ipc(BIND_EXT(9, 9), MOD_REQ(IPC4_MOD_BIND, 5, 0)), ==, MOD_REPLY(IPC4_MOD_BIND, 9));
+    g_assert_cmpuint(ipc(BIND_EXT(7, 0), MOD_REQ(IPC4_MOD_BIND, 9, 9)), ==, MOD_REPLY(IPC4_MOD_BIND, 9));
+    loop_config(0, 21);
+    g_assert_cmpuint(ipc(LC_EXT(0, 84), MOD_REQ(IPC4_MOD_LC_SET, 9, 9)), ==, MOD_REPLY(IPC4_MOD_LC_SET, 9));
+    g_assert_cmpuint(ipc(1u << 29, MOD_REQ(IPC4_MOD_LC_SET, 5, 0)), ==, MOD_REPLY(IPC4_MOD_LC_SET, 7));
+    g_assert_cmpuint(ipc(0, MOD_REQ(IPC4_MOD_DELETE, 9, 9)), ==, MOD_REPLY(IPC4_MOD_DELETE, 9));
+    loop_teardown();
+    g_assert_cmpuint(ipc(0, MOD_REQ(IPC4_MOD_DELETE, 5, 0)), ==, MOD_REPLY(IPC4_MOD_DELETE, 9));
+
+    /* the C2 builder's configuration carries the stream-tag placeholder
+     * (index 0xff) where no tag is known: a copier initialised with it
+     * names no stream and nothing moves until a large-config set names one */
+    qtest_memset(t.qs, CAPTURE_ADDR, loop_capture_fill, LOOP_BYTES);
+    loop_build((0u << 8) | 0xff, (1u << 8) | (LOOP_TAG_CAPTURE - 1));
+    g_assert_cmpuint(ipc(0, PPL_STATE(1, PPL_PAUSED)), ==, PPL_REPLY(IPC4_SET_PIPELINE_STATE, 0));
+    g_assert_cmpuint(ipc(0, PPL_STATE(1, PPL_RUNNING)), ==, PPL_REPLY(IPC4_SET_PIPELINE_STATE, 0));
+    loop_setup(IN0, LOOP_TAG_CAPTURE, BDL_CAPTURE);
+    loop_setup(OUT5, LOOP_TAG_RENDER, BDL_RENDER);
+    qtest_clock_step(t.qs, US(12000));
+    check_position(OUT5, 0, "the placeholder names no stream");
+    check_position(IN0, 0, "the placeholder names no stream");
+    check_capture_fill(0, LOOP_BYTES, "the placeholder names no stream");
+    check_loop_irq(false, "the placeholder names no stream");
+    loop_config((0u << 8) | (LOOP_TAG_RENDER - 1), 21);
+    g_assert_cmpuint(ipc(LC_EXT(0, 84), MOD_REQ(IPC4_MOD_LC_SET, 5, 0)), ==, MOD_REPLY(IPC4_MOD_LC_SET, 0));
+    qtest_clock_step(t.qs, US(5400));
+    check_position(OUT5, LOOP_PERIOD, "after the re-configuration");
+    check_position(IN0, LOOP_PERIOD, "after the re-configuration");
+    check_capture(0, LOOP_PERIOD, "after the re-configuration");
+    check_loop_irq(true, "after the re-configuration");
+    loop_ack();
+    loop_run(OUT5, false);
+    loop_run(IN0, false);
+    loop_teardown();
+    boot_end();
+}
+
 int main(int argc, char **argv)
 {
     g_test_init(&argc, &argv, NULL);
@@ -1107,6 +1464,7 @@ int main(int argc, char **argv)
         qtest_add_func("/intel-hda-ace/pipeline-faults", test_pipeline_faults);
         qtest_add_func("/intel-hda-ace/short-stream", test_short_stream);
         qtest_add_func("/intel-hda-ace/wrapped-offset", test_wrapped_offset);
+        qtest_add_func("/intel-hda-ace/audio-loopback", test_audio_loopback);
     }
     return g_test_run();
 }
-- 
