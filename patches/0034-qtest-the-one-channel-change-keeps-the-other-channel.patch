From aad450422c48a39e8d7f812a3de82873a4e2a121 Mon Sep 17 00:00:00 2001
From: Tasker <tasker@localhost>
Date: Sat, 28 Nov 2026 05:09:25 +0200
Subject: [PATCH 34/35] qtest: the one-channel change keeps the other channel
 at its volume

The row expected the right channel back at unity after a change of the
left alone; the component keeps every channel not named at the volume it
had, so the right stays at the -6 dB of the step before.
---
 tests/qtest/intel-hda-ace-test.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/tests/qtest/intel-hda-ace-test.c b/tests/qtest/intel-hda-ace-test.c
index 725f163cf..c925e0682 100644
--- a/tests/qtest/intel-hda-ace-test.c
+++ b/tests/qtest/intel-hda-ace-test.c
@@ -1564,7 +1564,7 @@ static void test_audio_gain(void)
     check_position(IN0, 0, "-6 dB: after the second period");
     check_capture_gain(LOOP_PERIOD, 0x4026e73d, "-6 dB");
     loop_ack();
-    /* one channel only: the left scaled, the right not */
+    /* one channel only: the left at one half, the right kept at -6 dB */
     gain_set(0, 0x40000000);
     qtest_clock_step(t.qs, US(5800));
     check_position(IN0, LOOP_PERIOD, "the left channel at one half: after the third period");
@@ -1576,7 +1576,8 @@ static void test_audio_gain(void)
         for (k = 0; k + 4 <= LOOP_PERIOD; k += 4) {
             int32_t render = ldl_le_p(loop_render + k);
             int32_t capture = ldl_le_p(got + k);
-            int64_t expected = (k & 4) ? render : ((int64_t)render * 0x40000000ll + (1ll << 30)) >> 31;
+            uint32_t volume = (k & 4) ? 0x4026e73d : 0x40000000;
+            int64_t expected = ((int64_t)render * volume + (1ll << 30)) >> 31;
 
             g_assert_cmpint(labs((long)(capture - expected)), <=, 1);
         }
